        case 1: return "Partly Cloudy";
        case 2: return "Cloudy";
        case 3: return "Rain";
        case 4: return "Snow";
        case 5: return "Thunderstorm";
        case 6: return "Fog";
        case 7: return "Freezing Rain";
        default: return "Unknown";
    }
