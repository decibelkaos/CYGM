# CYGM - CGM Display Default Configuration
# Target: ESP32 (ESP32-D0WD)

# Serial flasher config
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Partition Table
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# SPI RAM (disabled - JC2432W328 has no PSRAM)
CONFIG_SPIRAM=n

# SPI Flash - BOYA chip support
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# LCD and Touch Components
CONFIG_LCD_PANEL_IO_INCLUDE_TOUCH=y

# LVGL Configuration - Enable larger fonts for readability
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# LVGL Anti-aliasing for smooth edges
CONFIG_LV_FONT_SUBPX=y
CONFIG_LV_COLOR_DEPTH_16=y

# LVGL QR Code library (for About screen)
CONFIG_LV_USE_QRCODE=y

# ESP-TLS - Allow insecure connections for geocoding (non-critical data)
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
