# Build artifacts
build/
*.tmp
*.backup
*.before_*

# ESP-IDF
.vscode/
managed_components/
dependencies.lock

# Logs
*.log
*.txt
# ...but the build file is not a log. This rule had been quietly
# swallowing CMakeLists.txt, which is why the public snapshot has never
# contained one and could not be built from a clone.
!CMakeLists.txt

# Temporary files
NUL
temp_*

# Large directories
Documents/
.claude/

# Backups
*.tar.gz
savepoints/
.cache/

# Server-side runtime data, never committed
website/api/devices.json
website/api/devices.json.tmp

website/api/csp-reports.json
website/api/csp-reports.json.tmp

# Server-side secrets, kept above the docroot on the host and never in the repo
.cygm-private/
